# Free token from https://ion.cesium.com/tokens — enables 3D terrain (Earth) and 3D Moon/Mars tilesets
VITE_CESIUM_ION_TOKEN=

# Free API key from https://console.groq.com — powers Shastra AI assistant
VITE_GROQ_API_KEY=

# Google OAuth client ID from https://console.cloud.google.com/apis/credentials — enables Google sign-in
VITE_GOOGLE_CLIENT_ID=
